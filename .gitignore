### Mac OS ###
.DS_Store

# Runtime audit logs
logs/

# The extracted JavaFX SDK is intentionally committed for offline development.
# Its redundant download archive stays local-only.
/lib/openjfx-*.zip
!/lib/javafx-sdk-26.0.2/
!/lib/javafx-sdk-26.0.2/bin/
!/lib/javafx-sdk-26.0.2/bin/*.dll

# The complete OpenJDK is committed so the project can be configured offline.
# Generic IDE ignore rules above would otherwise hide its bin directory.
!/lib/jdk-26.0.2/
!/lib/jdk-26.0.2/bin/
!/lib/jdk-26.0.2/bin/**
/lib/openjdk-26.0.2_windows-x64_bin.zip
/lib/w64devkit-x64-*.7z.exe

# Portable native compiler is committed for fully offline DLL rebuilds.
!/lib/w64devkit-2.10.0/
!/lib/w64devkit-2.10.0/w64devkit/
!/lib/w64devkit-2.10.0/w64devkit/bin/
!/lib/w64devkit-2.10.0/w64devkit/bin/**

# Quantis SDK binaries are installed locally from the licensed vendor package
/lib/quantis/*.jar
/lib/quantis/*.dll
/lib/quantis/*.lib
!/lib/quantis/Quantis.dll

# Native build products from the retained NIST reference implementation
/third_party/nist-sts-2.1.2/upstream/sts-2.1.2/sts-2.1.2/assess
/third_party/nist-sts-2.1.2/upstream/sts-2.1.2/sts-2.1.2/obj/
